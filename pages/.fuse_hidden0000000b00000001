                <div className="text-lilly-navy font-semibold mt-0.5 capitalize">{active.emotionalTrigger}</div>
              </div>
              <div className="bg-lilly-mist rounded-lg p-2.5 col-span-2">
                <div className="text-[10px] font-bold uppercase tracking-wider text-lilly-grey">Recommended channels</div>
                <div className="text-lilly-navy font-semibold mt-0.5">
                  {active.channels.primary} <span className="text-lilly-grey font-normal">→ {active.channels.secondary.join(" · ")}</span>
                </div>
              </div>
            </div>

            <div className="mt-4 bg-lilly-redLight border border-lilly-red/20 rounded-lg p-3">
              <div className="text-[10px] font-bold uppercase tracking-wider text-lilly-redDark">CTA</div>
              <div className="text-[13px] font-bold text-lilly-navy mt-0.5">"{active.cta}"</div>
            </div>
          </div>
        </Card>

        <Card className="lg:col-span-2">
          <CardTitle title="Persistence Communication Support" subtitle="Multichannel messages auto-generated per cohort psychology — edit and send" action={
            <div className="flex items-center gap-2 text-[11px] text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md font-semibold border border-emerald-100">
              <Sparkles className="w-3.5 h-3.5" /> Generated · {((activeStats?.enrollmentProbability ?? 0.5) * 100).toFixed(0)}% predicted enrollment
            </div>
          } />

          <div className="space-y-3">
            <ChannelBlock icon={Send} label="SMS" tone="navy">
              <div className="text-[13px] text-lilly-ink leading-relaxed">{campaign.sms}</div>
            </ChannelBlock>

            <ChannelBlock icon={MessageSquare} label="WhatsApp" tone="green">
              <div className="text-[13px] text-lilly-ink leading-relaxed">{campaign.whatsapp}</div>
            </ChannelBlock>

            <ChannelBlock icon={Mail} label="Email" tone="navy">
              <div className="text-[12px] font-bold text-lilly-navy mb-1.5">Subject: {campaign.email.subject}</div>
              <div className="text-[12.5px] text-lilly-ink leading-relaxed whitespace-pre-line">{campaign.email.body}</div>
            </ChannelBlock>

            <ChannelBlock icon={Sparkles} label="App nudge" tone="red">
              <div className="text-[13px] text-lilly-ink leading-relaxed italic">"{campaign.appNudge}"</div>
            </ChannelBlock>
          </div>
        </Card>
      </div>

      {/* Coach campaign assist + similar success references */}
      <div className="px-8 grid grid-cols-1 lg:grid-cols-2 gap-5 mb-7">
        <Card>
          <CardTitle title="Coach Campaign Assist" subtitle={`${active.name} — talking points + objection handling`} action={<Badge color="red"><Phone className="w-3 h-3 mr-1" />coach</Badge>} />
          <div className="text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase">Recommended talking points</div>
          <ol className="mt-2 space-y-2 text-[12.5px]">
            {campaign.coachScript.map((s, i) => (
              <li key={i} className="flex items-start gap-2.5">
                <span className="w-5 h-5 rounded-md bg-lilly-navy text-white text-[10.5px] font-bold flex items-center justify-center shrink-0">{i + 1}</span>
                <span className="text-lilly-navy leading-snug">{s}</span>
              </li>
            ))}
          </ol>

          <div className="mt-4 text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase">Objection handling</div>
          <div className="mt-2 space-y-2">
            {campaign.objectionHandling.map((o, i) => (
              <div key={i} className="bg-lilly-mist rounded-lg p-2.5">
                <div className="text-[12px] font-bold text-lilly-navy">"{o.objection}"</div>
                <div className="text-[11.5px] text-lilly-grey mt-1 leading-snug">→ {o.response}</div>
              </div>
            ))}
          </div>
        </Card>

        <Card>
          <CardTitle title="Similar success references" subtitle={`Members like a ${active.name.toLowerCase()} prospect who succeeded — attach to outreach`} action={<Badge color="green">verified</Badge>} />
          <div className="bg-emerald-50 border border-emerald-100 rounded-lg p-3 flex items-start gap-2.5 mb-3">
            <Quote className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
            <div className="text-[12.5px] text-lilly-navy leading-relaxed">
              "<b>{Math.max(82, lookAlikes.length * 27)}</b> participants similar to you achieved an average <b>{(lookAlikes.reduce((a, p) => a + p.pctBwLoss, 0) / Math.max(1, lookAlikes.length)).toFixed(1)}%</b> body-weight reduction in 6 months."
            </div>
          </div>

          <div className="space-y-2.5">
            {lookAlikes.map(p => (
              <div key={p.id} className="border border-lilly-line rounded-lg p-3 hover:bg-lilly-mist/40">
                <div className="flex items-start justify-between mb-1.5">
                  <div>
                    <div className="text-[13px] font-bold text-lilly-navy">{p.name}</div>
                    <div className="text-[11px] text-lilly-grey">{p.age}{p.sex} · BMI {p.bmi.toFixed(0)} · {BUCKET_LABELS[p.bucket]}</div>
                  </div>
                  <Badge color="green" size="xs">verified</Badge>
                </div>
                <div className="text-[12px] text-lilly-navy">
                  Lost <b className="text-emerald-700">{p.pctBwLoss.toFixed(1)}%</b> in {p.weeksOnProgram} weeks · adherence {(p.pdc * 100).toFixed(0)}%
                </div>
              </div>
            ))}
          </div>
        </Card>
      </div>

      {/* Granular dimensions + micro-cluster example */}
      <div className="px-8 grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">
        <Card>
          <CardTitle title="Granular cluster dimensions" subtitle="Mix-and-match to create micro-clusters" />
          <div className="space-y-2.5">
            {GRANULAR_DIMENSIONS.map(d => (
              <div key={d.dim} className="bg-lilly-mist rounded-lg p-2.5">
                <div className="text-[11px] font-bold text-lilly-red uppercase tracking-wider">{d.dim}</div>
                <div className="text-[12px] text-lilly-navy mt-0.5">{d.examples.join(" · ")}</div>
              </div>
            ))}
          </div>
        </Card>

        <Card className="lg:col-span-2 bg-gradient-to-br from-lilly-navy via-lilly-navyDark to-black text-white border-lilly-navy">
          <div className="flex items-start gap-3 mb-3">
            <div className="w-10 h-10 rounded-xl bg-lilly-red text-white flex items-center justify-center shrink-0">
              <Wand2 className="w-5 h-5" />
            </div>
            <div>
              <div className="text-[10.5px] font-bold tracking-wider text-white/60 uppercase">Example AI micro-cluster</div>
              <div className="text-[16px] font-bold mt-0.5">An incredibly personalized segment, generated on demand</div>
            </div>
          </div>

          <div className="bg-black/30 border border-white/10 rounded-xl p-4 font-mono text-[13px] leading-relaxed text-white/95">
            "Women 35–45 with prediabetes,<br />
            high-stress jobs,<br />
            night-eating patterns,<br />
            previous failed programs,<br />
            low morning engagement"
          </div>

          <div className="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-[11.5px]">
            {[
              { k: "Estimated size", v: "~310 lives" },
              { k: "Predicted enroll", v: "64%" },
              { k: "Best channel", v: "WhatsApp + Coach" },
              { k: "Best window", v: "Wed 21:00 local" },
            ].map(x => (
              <div key={x.k} className="bg-white/10 border border-white/15 rounded-lg p-2.5">
                <div className="text-[10px] font-bold tracking-wider text-white/60 uppercase">{x.k}</div>
                <div className="font-bold mt-0.5">{x.v}</div>
              </div>
            ))}
          </div>

          <div className="mt-4 text-[12.5px] text-white/80 leading-relaxed">
            The platform composes any combination of clinical, behavioral, emotional, demographic, lifestyle, financial,
            program-history, and engagement dimensions to generate a micro-campaign cluster — with an AI-generated
            campaign and similar-success references attached automatically.
          </div>
        </Card>
      </div>

      {/* AI capabilities reference card */}
      <div className="px-8">
        <Card>
          <CardTitle title="AI-Powered Campaign Intelligence" subtitle="What the platform automates end-to-end" />
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
            {[
              { t: "Cluster Discovery", d: "AI identifies hidden cohorts from raw signals" },
              { t: "Campaign Suggestions", d: "AI suggests best messaging per cluster" },
              { t: "Conversion Prediction", d: "Predict enrollment probability per member" },
              { t: "Retention Prediction", d: "Predict 12-month continuation probability" },
              { t: "Best Outreach Time", d: "Optimal engagement window per member" },
              { t: "Channel Recommendation", d: "SMS / WhatsApp / Email / Coach selection" },
              { t: "Emotional Trigger Detection", d: "Confidence vs. fear vs. achievement" },
              { t: "Similar Success Matching", d: "Auto-attach references that look like the member" },
            ].map(x => (
              <div key={x.t} className="border border-lilly-line rounded-lg p-3 hover:border-lilly-red transition">
                <div className="flex items-start gap-2">
                  <Sparkles className="w-4 h-4 text-lilly-red shrink-0 mt-0.5" />
                  <div>
                    <div className="text-[12.5px] font-bold text-lilly-navy">{x.t}</div>
                    <div className="text-[11.5px] text-lilly-grey mt-0.5">{x.d}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </Card>
      </div>
    </div>
  );
}

function ChannelBlock({ icon: Icon, label, tone, children }: { icon: any; label: string; tone: "navy" | "red" | "green"; children: React.ReactNode }) {
  const toneCls = tone === "red" ? "border-lilly-red/40 bg-lilly-redLight/40"
    : tone === "green" ? "border-emerald-200 bg-emerald-50/60"
      : "border-lilly-line bg-lilly-mist/60";
  const iconCls = tone === "red" ? "bg-lilly-red text-white"
    : tone === "green" ? "bg-emerald-500 text-white"
      : "bg-lilly-navy text-white";
  return (
    <div className={`rounded-lg border ${toneCls} p-3 flex gap-3`}>
      <div className={`w-8 h-8 rounded-md flex items-center justify-center shrink-0 ${iconCls}`}>
        <Icon className="w-4 h-4" />
      </div>
      <div className="flex-1">
        <div className="text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase mb-1">{label}</div>
        {children}
      </div>
    </div>
