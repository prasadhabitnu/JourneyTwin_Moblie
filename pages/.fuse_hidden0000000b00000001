export default function Campaigns() {
  const stats = useMemo(clusterStats, []);
  const ranked = useMemo(
    () => [...stats].sort((a, b) => b.expectedConversions - a.expectedConversions),
    [stats]
  );

  // Default to the most "important" non-trivial cluster — Plateau/Failed if present, else top by population
  const defaultKey: ClusterKey =
    ranked.find(s => s.key === "PLATEAU_FAILED")?.key
    ?? ranked[0]?.key
    ?? "HIGH_CLINICAL_RISK";
  const [activeKey, setActiveKey] = useState<ClusterKey>(defaultKey);
  const active = CLUSTERS[activeKey];
  const activeStats = stats.find(s => s.key === activeKey);

  // Pull a representative patient + look-alike for that cluster (for similar success references)
  const sample = PATIENTS.find(p => clusterOf(p) === activeKey) ?? PATIENTS[0];
  const lookAlikes = useMemo(() => findLookAlikes(sample, 3), [sample]);
  const successRef = lookAlikes[0]
    ? { name: lookAlikes[0].name, loss: lookAlikes[0].pctBwLoss, weeks: lookAlikes[0].weeksOnProgram, bucket: BUCKET_LABELS[lookAlikes[0].bucket] }
    : undefined;
  const campaign = useMemo(() => generateCampaign(activeKey, successRef), [activeKey, sample]);

  // KPI strip
  const totalAddressable = ranked.reduce((a, s) => a + s.population, 0);
  const totalExpected = ranked.reduce((a, s) => a + s.expectedConversions, 0);
  const avgEnroll = totalAddressable > 0 ? totalExpected / totalAddressable : 0;
  const highRiskRetention = ranked.filter(s => s.retentionRisk === "High").reduce((a, s) => a + s.population, 0);
  const criticalClusters = ranked.filter(s => s.def.importance === "critical").length;

  // Heatmap: cluster × state (top 6 states)
  const stateCounts = new Map<string, number>();
  for (const p of PATIENTS) stateCounts.set(p.state, (stateCounts.get(p.state) ?? 0) + 1);
  const topStates = Array.from(stateCounts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([s]) => s);
  const heatRows = ranked.filter(s => s.key !== "UNSEGMENTED").map(s => {
    const row: Record<string, any> = { cluster: s.def.name, key: s.key };
    for (const st of topStates) {
      row[st] = PATIENTS.filter(p => clusterOf(p) === s.key && p.state === st).length;
    }
    return row;
  });
  const maxHeat = Math.max(1, ...heatRows.flatMap(r => topStates.map(st => r[st] as number)));

  // Cluster scatter: enrollment prob vs population, sized by retention risk
  const scatterData = ranked.filter(s => s.key !== "UNSEGMENTED").map(s => ({
    name: s.def.name,
    population: s.population,
    enrollment: Math.round(s.enrollmentProbability * 100),
    risk: s.retentionRiskScore * 200,
    color: s.def.color,
  }));

  // Cluster size pie
  const pieData = ranked.map(s => ({ name: s.def.name, value: s.population, color: s.def.color }));

  return (
    <div className="pb-12">
      <PageHeader
        eyebrow="GLP-1 PERSISTENCE INTERVENTIONS"
        title="Identify drifting members. Act early. Improve persistence."
        subtitle="Fathom detects early behavioral drift and surfaces the right intervention for the right member at the right time. Each cohort below is AI-segmented by drift signals, risk of discontinuation, and recoverability."
        actions={
          <button className="inline-flex items-center gap-2 px-4 py-2 bg-lilly-red text-white rounded-lg shadow-md hover:bg-red-700 transition text-[13px] font-semibold">
            <Sparkles className="w-4 h-4" />
            Generate interventions
          </button>
        }
      />

      <div className="px-8 grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
        <PiTile Icon={Users}        iconBg="bg-red-50"     iconColor="text-lilly-red"    label="Active Drift Cohorts"          value="7"     sub="with intervention plays" />
        <PiTile Icon={Users}        iconBg="bg-blue-50"    iconColor="text-blue-600"     label="Members Monitored"             value="1,000" sub="across all cohorts" />
        <PiTile Icon={RefreshCw}    iconBg="bg-emerald-50" iconColor="text-emerald-600"  label="Recoverable Members"           value="616"   valueColor="text-emerald-600" sub="62% of monitored" />
        <PiTile Icon={AlertOctagon} iconBg="bg-amber-50"   iconColor="text-amber-600"    label="Immediate Intervention Needed" value="207"   valueColor="text-amber-600"   sub="high risk of discontinuation" />
        <PiTile Icon={Megaphone}    iconBg="bg-purple-50"  iconColor="text-purple-600"   label="Intervention Channels"         value="5"     sub="SMS · WhatsApp · Email · Coach · App" />
      </div>

      <div className="px-8 mb-7">
        <div className="mb-3">
          <div className="text-[11px] font-bold tracking-wider text-lilly-grey uppercase">DRIFT COHORTS &amp; RECOMMENDED INTERVENTIONS</div>
          <div className="text-[12px] text-lilly-grey mt-0.5">Click any cohort to view members and recommended intervention plan</div>
        </div>
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-3">
          {DRIFT_COHORTS.map(c => {
            const sev = SEV_COLOR_OVERRIDE[c.id] ?? SEV_COLOR[c.severity];
            const Icon = c.Icon;
            return (
              <div key={c.id} className="bg-white border border-lilly-line rounded-xl shadow-card overflow-hidden hover:shadow-md hover:-translate-y-0.5 transition cursor-pointer">
                <div className="px-3 py-1 text-[10px] font-bold tracking-wider" style={{background: sev.bg, color: sev.fg}}>{c.rank} · {c.severity}</div>
                <div className="p-3 text-center">
                  <div className="mx-auto w-12 h-12 rounded-full flex items-center justify-center mb-2" style={{background: c.iconBg}}>
                    <Icon className="w-5 h-5" style={{color: c.iconColor}} />
                  </div>
                  <div className="font-bold text-[12.5px] text-lilly-navy leading-tight min-h-[34px]">{c.name}</div>
                  <div className="text-[11px] text-lilly-grey mt-1.5 leading-snug min-h-[44px]">{c.description}</div>
                  <div className="grid grid-cols-2 gap-2 pt-2 mt-2 border-t border-lilly-line">
                    <div>
                      <div className="text-[9.5px] font-bold text-lilly-grey tracking-wider uppercase">Pop.</div>
                      <div className="text-[13px] font-bold text-lilly-navy">{c.population}</div>
                    </div>
                    <div>
                      <div className="text-[9.5px] font-bold text-lilly-grey tracking-wider uppercase">Risk</div>
                      <div className="text-[12px] font-bold" style={{color: c.risk === "Critical" ? "#991B1B" : c.risk === "High" ? "#9A3412" : c.risk === "Medium" ? "#92400E" : "#1E40AF"}}>{c.risk}</div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div className="px-8 mb-8">
        <Card padding="p-0">
          <div className="px-5 pt-4 pb-3 flex items-start justify-between border-b border-lilly-line">
            <div>
              <div className="flex items-center gap-2">
                <div className="text-[12px] font-bold tracking-wider text-lilly-grey uppercase">INTERVENTION OPPORTUNITY MATRIX</div>
                <Badge color="red">live</Badge>
              </div>
              <div className="text-[12px] text-lilly-grey mt-0.5">Where to focus intervention efforts — sorted by expected recovery impact</div>
            </div>
          </div>
          <table className="w-full text-[12.5px]">
