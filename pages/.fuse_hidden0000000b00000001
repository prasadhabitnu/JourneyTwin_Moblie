            <div className="mt-4 text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase">Messaging pillars</div>
            <ul className="mt-1.5 space-y-1 text-[12.5px] text-lilly-navy">
              {active.messaging.map(c => (
                <li key={c} className="flex items-start gap-2"><span className="mt-1.5 w-1.5 h-1.5 rounded-full bg-lilly-navy shrink-0" />{c}</li>
