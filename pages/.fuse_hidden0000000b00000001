                <th className="text-left py-2.5">Recommended Action</th>
                <th className="text-left py-2.5">Primary Channel</th>
                <th className="text-center py-2.5 pr-5">Priority</th>
              </tr>
            </thead>
            <tbody>
              {DRIFT_COHORTS.map(c => {
                const recov = RECOV_BAR[c.expectedRecovery];
                const ChIcon = CHANNEL_ICON[c.primaryChannel] ?? Mail;
                return (
                  <tr key={c.id} className="border-b border-lilly-line/60 hover:bg-lilly-mist/40 transition">
                    <td className="py-3 px-5">
                      <div className="flex items-center gap-2.5">
                        <span className="w-2.5 h-2.5 rounded-full flex-shrink-0" style={{background: c.dotColor}} />
                        <span className="text-[12px] text-lilly-grey font-mono">{c.rank}.</span>
                        <span className="font-semibold text-lilly-navy">{c.name}</span>
                      </div>
                    </td>
                    <td className="text-lilly-grey text-[11.5px] pr-3 leading-snug max-w-[220px]">{c.signals}</td>
                    <td className="text-right font-bold text-lilly-navy pr-3">{c.population}</td>
                    <td className="text-center">
                      <span className={`inline-block px-2.5 py-0.5 rounded text-[10.5px] font-bold ${RISK_PILL[c.risk]}`}>{c.risk}</span>
                    </td>
                    <td className="pr-3">
                      <div className="flex items-center gap-2">
                        <div className="flex-1 max-w-[80px] h-1.5 rounded-full bg-lilly-mist overflow-hidden">
                          <div className="h-full rounded-full" style={{ width: recov.width, background: recov.color }} />
                        </div>
                        <span className="text-[11.5px] font-semibold" style={{color: recov.color}}>{c.expectedRecovery}</span>
                      </div>
                    </td>
                    <td className="text-lilly-navy text-[11.5px] pr-3 leading-snug max-w-[230px]">{c.recommendedAction}</td>
                    <td className="pr-3">
                      <div className="inline-flex items-center gap-1.5 text-[11.5px] text-lilly-navy">
                        <ChIcon className="w-3.5 h-3.5 text-lilly-grey" />
                        <span>{c.primaryChannel}</span>
                      </div>
                    </td>
                    <td className="text-center pr-5">
                      <span className={`inline-block px-2.5 py-0.5 rounded text-[10.5px] font-bold ${PRIORITY_PILL[c.priority]}`}>{c.priority}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </Card>
      </div>

     
      {/* Cluster intelligence: scatter + pie + heatmap */}
      <div className="px-8 grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">
        <Card>
          <CardTitle title="Cluster size distribution" subtitle="Share of total addressable population" />
          <ResponsiveContainer width="100%" height={260}>
            <PieChart>
              <Pie data={pieData} dataKey="value" nameKey="name" innerRadius={45} outerRadius={90} paddingAngle={2}>
                {pieData.map((d, i) => <Cell key={i} fill={d.color} />)}
              </Pie>
              <Tooltip />
            </PieChart>
          </ResponsiveContainer>
        </Card>

        <Card>
          <CardTitle title="Channel mix (recommended spend)" subtitle="Across all active clusters" />
          <ResponsiveContainer width="100%" height={260}>
            <BarChart data={CHANNEL_MIX} layout="vertical" margin={{ top: 5, right: 10, left: 0, bottom: 0 }}>
              <CartesianGrid strokeDasharray="3 6" stroke="#E5E8EE" horizontal={false} />
              <XAxis type="number" tick={{ fontSize: 11, fill: "#4A4A4A" }} />
              <YAxis dataKey="channel" type="category" tick={{ fontSize: 11, fill: "#1B2A4E", fontWeight: 600 }} width={90} axisLine={false} tickLine={false} />
              <Tooltip />
              <Bar dataKey="value" fill={RED} radius={[0, 4, 4, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </Card>

        <Card>
          <CardTitle title="Enrollment vs. population" subtitle="Bubble size = retention risk" />
          <ResponsiveContainer width="100%" height={260}>
            <ScatterChart margin={{ top: 10, right: 20, bottom: 10, left: 5 }}>
              <CartesianGrid strokeDasharray="3 6" stroke="#E5E8EE" />
              <XAxis type="number" dataKey="population" name="Population" tick={{ fontSize: 11, fill: "#4A4A4A" }} label={{ value: "Population", position: "insideBottom", offset: -5, fill: "#4A4A4A", fontSize: 11 }} />
              <YAxis type="number" dataKey="enrollment" name="Enrollment %" domain={[0, 100]} tick={{ fontSize: 11, fill: "#4A4A4A" }} label={{ value: "Enroll %", angle: -90, position: "insideLeft", fill: "#4A4A4A", fontSize: 11 }} />
              <ZAxis type="number" dataKey="risk" range={[80, 320]} />
              <Tooltip cursor={{ strokeDasharray: "3 3" }} />
              <Scatter data={scatterData}>
                {scatterData.map((d, i) => <Cell key={i} fill={d.color} fillOpacity={0.75} />)}
              </Scatter>
            </ScatterChart>
          </ResponsiveContainer>
        </Card>
      </div>

      {/* Cluster heatmap */}
      <div className="px-8 mb-7">
        <Card>
          <CardTitle title="Cluster heatmap by state" subtitle="High-conversion zones, dropout zones, obesity hotspots — all in one view" action={<Badge color="red"><MapPin className="w-3 h-3 mr-1" />geo</Badge>} />
          <div className="overflow-x-auto">
            <table className="w-full text-[12px]">
              <thead>
                <tr>
                  <th className="text-left py-1.5 pr-3 text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase">Cluster</th>
                  {topStates.map(s => (
                    <th key={s} className="text-center text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase pb-1.5">{s}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {heatRows.map(row => (
                  <tr key={row.key as string}>
                    <td className="pr-3 py-1 font-semibold text-lilly-navy">
                      <div className="flex items-center gap-2">
                        <span className="w-2 h-2 rounded-full" style={{ background: CLUSTERS[row.key as ClusterKey].color }} />
                        {row.cluster}
                      </div>
                    </td>
                    {topStates.map(st => {
                      const v = row[st] as number;
                      const intensity = v / maxHeat;
                      return (
                        <td key={st} className="px-1 py-1">
                          <div
                            className="text-center text-[11px] font-bold rounded-md py-1.5"
                            style={{
                              background: `rgba(213, 43, 30, ${0.10 + intensity * 0.75})`,
                              color: intensity > 0.5 ? "#fff" : "#1B2A4E",
                            }}
                          >
                            {v}
                          </div>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-3 flex items-center gap-2 text-[11px] text-lilly-grey">
            <span>Lower</span>
            <div className="flex-1 h-2 rounded" style={{ background: "linear-gradient(to right, rgba(213,43,30,0.10), rgba(213,43,30,0.85))" }} />
            <span>Higher concentration</span>
          </div>
        </Card>
      </div>

      {/* AI Campaign Generator — multichannel for active cluster */}
      <div className="px-8 grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">
        <Card>
          <CardTitle title={active.name} subtitle={`Theme — "${active.theme}"`} action={<span className={`text-[10.5px] font-bold px-2 py-0.5 rounded ${active.badge}`}>{active.importance ?? "standard"}</span>} />
          <div>
            <div className="text-[10.5px] font-bold tracking-wider text-lilly-grey uppercase">Characteristics</div>
            <ul className="mt-1.5 space-y-1 text-[12.5px] text-lilly-navy">
              {active.characteristics.map(c => (
                <li key={c} className="flex items-start gap-2"><span className="mt-1.5 w-1.5 h-1.5 rounded-full bg-lilly-red shrink-0" />{c}</li>
              ))}
